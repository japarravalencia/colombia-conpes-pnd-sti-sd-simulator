	</model>
	<model name="Sector_2_Firms_Adoption_Chain">
		<variables>
			<aux name="firm creation rate base" ai_state="C">
				<doc>Fractional firm creation.</doc>
				<eqn>0.03</eqn>
				<units>1/Year</units>
			</aux>
			<aux name="base adoption rate" ai_state="C">
				<doc>Base fractional adoption.</doc>
				<eqn>0.0107</eqn>
				<units>1/Year</units>
			</aux>
			<aux name="base regression rate" ai_state="C">
				<doc>Base fractional regression.</doc>
				<eqn>0.05</eqn>
				<units>1/Year</units>
			</aux>
			<aux name="firm exit rate base" ai_state="C">
				<doc>Base fractional firm exit.</doc>
				<eqn>0.025</eqn>
				<units>1/Year</units>
			</aux>
			<aux name="innovative exit multiplier" ai_state="C">
				<doc>Innovative firms exit at this fraction of the base exit rate.</doc>
				<eqn>0.5</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="avg adoption duration" ai_state="C">
				<doc>Mean adoption duration.</doc>
				<eqn>4</eqn>
				<units>Year</units>
			</aux>
			<flow name="new firm creation" ai_state="C">
				<doc>Gross entrepreneurial creation of new traditional businesses in the economy.</doc>
				<eqn>total_firms*firm_creation_rate_base</eqn>
				<non_negative/>
				<units>Firms/Years</units>
			</flow>
			<flow name="firm adoption rate" ai_state="C">
				<doc>Rate at which traditional firms transition to technology adoption spurred by available solutions and institutional linkage.</doc>
				<eqn>traditional_firms*base_adoption_rate*(active_industrial_solutions/(active_industrial_solutions+ref_solutions_half_sat))*gov_uni_ind_linkage</eqn>
				<non_negative/>
				<units>Firms/Years</units>
			</flow>
			<flow name="firm conversion rate" ai_state="C">
				<doc>Conversion of adopting firms into mature innovative enterprises reinforced by systems engineering rigor.</doc>
				<eqn>adopting_firms*incose_rigor_index/avg_adoption_duration</eqn>
				<non_negative/>
				<units>Firms/Years</units>
			</flow>
			<flow name="firm regression rate" ai_state="C">
				<doc>Loss of innovation standing back to intermediate adopting status caused by inadequate methodology maintenance.</doc>
				<eqn>innovative_firms*base_regression_rate*(1-incose_rigor_index)</eqn>
				<non_negative/>
				<units>Firms/Years</units>
			</flow>
			<flow name="traditional firm exit" ai_state="C">
				<doc>Exit and closure of conventional enterprises due to general market obsolescence and competition.</doc>
				<eqn>traditional_firms*firm_exit_rate_base</eqn>
				<non_negative/>
				<units>Firms/Years</units>
			</flow>
			<flow name="adopting firm exit" ai_state="C">
				<doc>Business closure rate among enterprises in the adoption stage.</doc>
				<eqn>adopting_firms*firm_exit_rate_base</eqn>
				<non_negative/>
				<units>Firms/Years</units>
			</flow>
			<flow name="innovative firm exit" ai_state="C">
				<doc>Exit rate of innovative enterprises reflecting lower business failure probabilities.</doc>
				<eqn>innovative_firms*firm_exit_rate_base*innovative_exit_multiplier</eqn>
				<non_negative/>
				<units>Firms/Years</units>
			</flow>
			<stock name="adopting firms" ai_state="C" access="output" isee:autocreated="true">
				<doc>Firms adopting innovation.</doc>
				<eqn>8000</eqn>
				<inflow>firm_adoption_rate</inflow>
				<inflow>firm_regression_rate</inflow>
				<outflow>firm_conversion_rate</outflow>
				<outflow>adopting_firm_exit</outflow>
				<units>Firms</units>
			</stock>
			<aux name="total firms" ai_state="C" access="output" isee:autocreated="true">
				<doc>Total firms; changes only via creation and exit.</doc>
				<eqn>traditional_firms + adopting_firms + innovative_firms</eqn>
				<units>Firms</units>
			</aux>
			<stock name="innovative firms" ai_state="C" access="output" isee:autocreated="true">
				<doc>Innovative firms.</doc>
				<eqn>8000</eqn>
				<inflow>firm_conversion_rate</inflow>
				<outflow>firm_regression_rate</outflow>
				<outflow>innovative_firm_exit</outflow>
				<units>Firms</units>
			</stock>
			<stock name="active industrial solutions" ai_state="C" access="input">
				<doc>Solutions in industrial use.</doc>
				<eqn>600</eqn>
				<units>Projects</units>
			</stock>
			<aux name="ref solutions half sat" ai_state="C" access="input">
				<doc>Half-saturation level of active solutions.</doc>
				<eqn>600.0</eqn>
				<units>Projects</units>
			</aux>
			<aux name="incose rigor index" ai_state="C" access="input">
				<doc>Systems engineering rigor policy lever (0-1).</doc>
				<eqn>0.6</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="gov uni ind linkage" ai_state="C" access="input">
				<doc>Government-university-industry linkage policy lever (0-1).</doc>
				<eqn>0.5</eqn>
				<units>dmnl</units>
			</aux>
			<stock name="traditional firms" ai_state="C">
				<doc>Traditional firms.</doc>
				<eqn>84000</eqn>
				<inflow>new_firm_creation</inflow>
				<outflow>firm_adoption_rate</outflow>
				<outflow>traditional_firm_exit</outflow>
				<units>Firms</units>
			</stock>
		</variables>
