	</model>
	<model name="Sector_1_Talent_Conservation">
		<variables>
			<aux name="domestic talent demand" ai_state="C">
				<doc>Total STI labor absorptive capacity demanded by adopting and innovative productive enterprises.</doc>
				<eqn>innovative_firms*talent_per_innovative_firm+adopting_firms*talent_per_adopting_firm</eqn>
				<units>People</units>
			</aux>
			<aux name="unabsorbed talent" ai_state="C">
				<doc>Active researchers exceeding the absorption capacity of domestic firms driving brain drain pressures.</doc>
				<eqn>MAX(0, active_sti_talent - domestic_talent_demand)</eqn>
				<units>People</units>
			</aux>
			<aux name="desired talent intake" ai_state="C" access="output" isee:autocreated="true">
				<doc>Target annual recruitment of advanced students scaled by ecosystem prestige and attractiveness.</doc>
				<eqn>base_talent_intake*sti_attractiveness_factor</eqn>
				<units>People/Year</units>
			</aux>
			<aux name="total sti people" ai_state="C">
				<doc>Total talent; changes only via formation and retirement.</doc>
				<eqn>talent_in_training + active_sti_talent + diaspora_talent</eqn>
				<units>People</units>
			</aux>
			<aux name="avg training duration" ai_state="C">
				<doc>Mean training duration.</doc>
				<eqn>4</eqn>
				<units>Year</units>
			</aux>
			<aux name="base talent intake" ai_state="C">
				<doc>Baseline annual intake capacity of university postgraduate systems.</doc>
				<eqn>1412.5</eqn>
				<units>People/Year</units>
			</aux>
			<aux name="talent per innovative firm" ai_state="C">
				<doc>STI talent demanded per innovative firm.</doc>
				<eqn>1.5</eqn>
				<units>People/Firms</units>
			</aux>
			<aux name="talent per adopting firm" ai_state="C">
				<doc>STI talent demanded per adopting firm.</doc>
				<eqn>0.2</eqn>
				<units>People/Firms</units>
			</aux>
			<aux name="base emigration rate" ai_state="C">
				<doc>Base fractional emigration.</doc>
				<eqn>0.0325</eqn>
				<units>1/Year</units>
			</aux>
			<aux name="excess emigration rate" ai_state="C">
				<doc>Fractional emigration of unabsorbed talent.</doc>
				<eqn>0.15</eqn>
				<units>1/Year</units>
			</aux>
			<aux name="base repatriation rate" ai_state="C">
				<doc>Base fractional repatriation.</doc>
				<eqn>0.03</eqn>
				<units>1/Year</units>
			</aux>
			<aux name="retirement rate" ai_state="C">
				<doc>Fractional retirement.</doc>
				<eqn>0.03</eqn>
				<units>1/Year</units>
			</aux>
			<flow name="new talent formation" ai_state="C">
				<doc>Annual inflow of new trainees supported by executed national training and scholarship allocations.</doc>
				<eqn>talent_program_funding_rate/cost_per_talent_trained</eqn>
				<non_negative/>
				<units>People/Year</units>
			</flow>
			<flow name="talent graduating" ai_state="C">
				<doc>Completion rate of postgraduates transitioning into the active domestic STI labor market.</doc>
				<eqn>talent_in_training/avg_training_duration</eqn>
				<non_negative/>
				<units>People/Year</units>
			</flow>
			<flow name="talent emigration" ai_state="C">
				<doc>Outflow of active talent departing the country driven by baseline mobility and domestic labor absorption deficits.</doc>
				<eqn>active_sti_talent*base_emigration_rate+unabsorbed_talent*excess_emigration_rate</eqn>
				<non_negative/>
				<units>People/Year</units>
			</flow>
			<flow name="talent repatriation" ai_state="C">
				<doc>Flow of researchers returning from the diaspora modulated by ecosystem attractiveness.</doc>
				<eqn>diaspora_talent*base_repatriation_rate*sti_attractiveness_factor</eqn>
				<non_negative/>
				<units>People/Year</units>
			</flow>
			<flow name="talent retirement" ai_state="C">
				<doc>Natural demographic attrition of active researchers leaving the STI workforce.</doc>
				<eqn>active_sti_talent*retirement_rate</eqn>
				<non_negative/>
				<units>People/Year</units>
			</flow>
			<aux name="talent program funding rate" ai_state="C" access="input">
				<doc>Actual fiscal capital disbursed to fund postgraduate trainees and doctoral grants.</doc>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>Million_USD/Year</units>
			</aux>
			<aux name="sti attractiveness factor" ai_state="C" access="input">
				<doc>Composite ecosystem attractiveness index driving researcher retention, repatriation, and student aspirations.</doc>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>dmnl</units>
			</aux>
			<stock name="talent in training" ai_state="C">
				<doc>Talent currently in training.</doc>
				<eqn>2400</eqn>
				<inflow>new_talent_formation</inflow>
				<outflow>talent_graduating</outflow>
				<units>People</units>
			</stock>
			<stock name="active sti talent" ai_state="C" access="output" isee:autocreated="true">
				<doc>STI talent active domestically.</doc>
				<eqn>3550</eqn>
				<inflow>talent_graduating</inflow>
				<inflow>talent_repatriation</inflow>
				<outflow>talent_emigration</outflow>
				<outflow>talent_retirement</outflow>
				<units>People</units>
			</stock>
			<stock name="diaspora talent" ai_state="C">
				<doc>STI talent abroad.</doc>
				<eqn>1800</eqn>
				<inflow>talent_emigration</inflow>
				<outflow>talent_repatriation</outflow>
				<units>People</units>
			</stock>
			<stock name="innovative firms" ai_state="C" access="input">
				<doc>Innovative firms.</doc>
				<eqn>8000</eqn>
				<units>Firms</units>
			</stock>
			<stock name="adopting firms" ai_state="C" access="input">
				<doc>Firms adopting innovation.</doc>
				<eqn>8000</eqn>
				<units>Firms</units>
			</stock>
			<aux name="cost per talent trained" ai_state="C" access="input">
				<doc>Cost per trained person.</doc>
				<eqn>0.205</eqn>
				<units>Million_USD/People</units>
			</aux>
		</variables>
