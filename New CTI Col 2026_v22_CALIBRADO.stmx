				<aux font_style="italic" font_weight="bold" x="568.375" y="670.824" name="sti attractiveness factor"/>
				<connector uid="2" polarity="-" isee:polarity_placement="outside" angle="318.801">
					<isee:documentation>Reasoning:
Longer average training slows the annual graduation rate.

Polarity Reasoning: 
Higher duration decreases graduation throughput.</isee:documentation>
					<isee:reasoning>Longer average training slows the annual graduation rate.</isee:reasoning>
					<isee:polarity_reasoning>Higher duration decreases graduation throughput.</isee:polarity_reasoning>
					<from>avg_training_duration</from>
					<to>talent_graduating</to>
				</connector>
				<connector uid="5" polarity="-" isee:polarity_placement="outside" angle="147.216">
					<isee:documentation>Reasoning:
Higher firm employment demand absorbs talent, reducing surplus.

Polarity Reasoning: 
Reduces unabsorbed talent pool.</isee:documentation>
					<isee:reasoning>Higher firm employment demand absorbs talent, reducing surplus.</isee:reasoning>
					<isee:polarity_reasoning>Reduces unabsorbed talent pool.</isee:polarity_reasoning>
					<from>domestic_talent_demand</from>
					<to>unabsorbed_talent</to>
				</connector>
				<connector uid="7" polarity="+" isee:polarity_placement="outside" angle="162.417">
					<isee:documentation>Reasoning:
Higher researcher staffing density raises overall industrial demand.

Polarity Reasoning: 
Increases aggregate talent demand.</isee:documentation>
					<isee:reasoning>Higher researcher staffing density raises overall industrial demand.</isee:reasoning>
					<isee:polarity_reasoning>Increases aggregate talent demand.</isee:polarity_reasoning>
					<from>talent_per_innovative_firm</from>
					<to>domestic_talent_demand</to>
				</connector>
				<connector uid="9" polarity="+" isee:polarity_placement="outside" angle="95.5149">
					<isee:documentation>Reasoning:
Technical staffing per adopting firm scales domestic demand.

Polarity Reasoning: 
Increases talent demand.</isee:documentation>
					<isee:reasoning>Technical staffing per adopting firm scales domestic demand.</isee:reasoning>
					<isee:polarity_reasoning>Increases talent demand.</isee:polarity_reasoning>
					<from>talent_per_adopting_firm</from>
					<to>domestic_talent_demand</to>
				</connector>
				<connector uid="11" polarity="+" isee:polarity_placement="outside" angle="320.022">
					<isee:documentation>Reasoning:
Higher base propensity raises the baseline flow of emigrants.

Polarity Reasoning: 
Direct positive effect on emigration.</isee:documentation>
					<isee:reasoning>Higher base propensity raises the baseline flow of emigrants.</isee:reasoning>
					<isee:polarity_reasoning>Direct positive effect on emigration.</isee:polarity_reasoning>
					<from>base_emigration_rate</from>
					<to>talent_emigration</to>
				</connector>
				<connector uid="12" polarity="+" isee:polarity_placement="outside" angle="319.656">
					<isee:documentation>Reasoning:
Lack of local job opportunities accelerates researcher flight overseas.

Polarity Reasoning: 
More unabsorbed talent directly accelerates emigration.</isee:documentation>
					<isee:reasoning>Lack of local job opportunities accelerates researcher flight overseas.</isee:reasoning>
					<isee:polarity_reasoning>More unabsorbed talent directly accelerates emigration.</isee:polarity_reasoning>
					<from>unabsorbed_talent</from>
					<to>talent_emigration</to>
				</connector>
				<connector uid="13" polarity="+" isee:polarity_placement="outside" angle="318.248">
					<isee:documentation>Reasoning:
Higher sensitivity to unemployment increases brain drain intensity.

Polarity Reasoning: 
Increases emigration rate.</isee:documentation>
					<isee:reasoning>Higher sensitivity to unemployment increases brain drain intensity.</isee:reasoning>
					<isee:polarity_reasoning>Increases emigration rate.</isee:polarity_reasoning>
					<from>excess_emigration_rate</from>
					<to>talent_emigration</to>
				</connector>
				<connector uid="15" polarity="+" isee:polarity_placement="outside" angle="320.213">
					<isee:documentation>Reasoning:
Higher willingness to return raises the return flow.

Polarity Reasoning: 
Increases repatriation rate.</isee:documentation>
					<isee:reasoning>Higher willingness to return raises the return flow.</isee:reasoning>
					<isee:polarity_reasoning>Increases repatriation rate.</isee:polarity_reasoning>
					<from>base_repatriation_rate</from>
					<to>talent_repatriation</to>
				</connector>
				<connector uid="16" polarity="+" isee:polarity_placement="outside" angle="311.581">
					<isee:documentation>Reasoning:
Ecosystem prestige and opportunity encourage scientists abroad to return.

Polarity Reasoning: 
High attractiveness amplifies repatriation.</isee:documentation>
					<isee:reasoning>Ecosystem prestige and opportunity encourage scientists abroad to return.</isee:reasoning>
					<isee:polarity_reasoning>High attractiveness amplifies repatriation.</isee:polarity_reasoning>
					<from>
						<alias uid="17"/>
					</from>
					<to>talent_repatriation</to>
				</connector>
				<connector uid="19" polarity="+" isee:polarity_placement="outside" angle="302.523">
					<isee:documentation>Reasoning:
Higher demographic turnover raises retirements.

Polarity Reasoning: 
Direct positive link.</isee:documentation>
					<isee:reasoning>Higher demographic turnover raises retirements.</isee:reasoning>
					<isee:polarity_reasoning>Direct positive link.</isee:polarity_reasoning>
					<from>retirement_rate</from>
					<to>talent_retirement</to>
				</connector>
				<connector uid="20" angle="292.426">
					<from>base_talent_intake</from>
					<to>desired_talent_intake</to>
				</connector>
				<connector uid="21" polarity="+" isee:polarity_placement="outside" angle="178.025">
					<isee:documentation>Reasoning:
Greater attractiveness attracts more applicants and expands recruitment targets.

Polarity Reasoning: 
Increases desired talent intake.</isee:documentation>
					<isee:reasoning>Greater attractiveness attracts more applicants and expands recruitment targets.</isee:reasoning>
					<isee:polarity_reasoning>Increases desired talent intake.</isee:polarity_reasoning>
					<from>
						<alias uid="22"/>
					</from>
					<to>desired_talent_intake</to>
				</connector>
				<connector uid="27" polarity="+" isee:polarity_placement="outside" angle="301.246">
					<isee:documentation>Reasoning:
Funding disbursements pay for new student cohorts.

Polarity Reasoning: 
More funding expands student formation.</isee:documentation>
					<isee:reasoning>Funding disbursements pay for new student cohorts.</isee:reasoning>
					<isee:polarity_reasoning>More funding expands student formation.</isee:polarity_reasoning>
					<from>talent_program_funding_rate</from>
					<to>new_talent_formation</to>
				</connector>
