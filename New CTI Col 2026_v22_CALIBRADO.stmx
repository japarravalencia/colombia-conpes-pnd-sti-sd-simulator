				</connector>
				<connector uid="18" polarity="+" isee:polarity_placement="outside" angle="26.4383">
					<isee:documentation>Reasoning:
Baseline capability decay rate raises regression.

Polarity Reasoning: 
Direct positive link.</isee:documentation>
					<isee:reasoning>Baseline capability decay rate raises regression.</isee:reasoning>
					<isee:polarity_reasoning>Direct positive link.</isee:polarity_reasoning>
					<from>base_regression_rate</from>
