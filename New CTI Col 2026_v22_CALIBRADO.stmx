		<variables>
			<aux name="innovative firm share" ai_state="C">
				<doc>Proportion of total productive enterprises that operate as mature innovative firms.</doc>
				<eqn>innovative_firms / MAX(1, total_firms)</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="gdp growth rate" ai_state="C">
				<doc>Real annual economic growth rate boosted endogenously by the penetration of innovative firms.</doc>
				<eqn>baseline_gdp_growth_rate+innovation_gdp_elasticity*innovative_firm_share</eqn>
				<units>1/Year</units>
			</aux>
			<stock name="gdp" ai_state="C" access="output" isee:autocreated="true">
				<doc>National gross domestic product evolving as a continuous stock (eliminates retroactive EXP artifact).</doc>
				<eqn>gdp_initial</eqn>
				<inflow>gdp_growth</inflow>
				<units>Million_USD/Year</units>
			</stock>
			<flow name="gdp growth" ai_state="C">
				<doc>Annual continuous GDP expansion driven by baseline growth and innovative firm share.</doc>
				<eqn>gdp*gdp_growth_rate</eqn>
				<non_negative/>
				<units>Million_USD/(Year*Year)</units>
			</flow>
			<aux name="sti attractiveness factor" ai_state="C" access="output" isee:autocreated="true">
				<doc>Composite ecosystem attractiveness index driving researcher retention, repatriation, and student aspirations.</doc>
				<eqn>attractiveness_floor+attractiveness_saturation_weight*(active_industrial_solutions/ref_solutions_half_sat)/(1+active_industrial_solutions/ref_solutions_half_sat)+attractiveness_innovation_weight*innovative_firm_share</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="model start year" ai_state="C">
				<doc>Calendar year at which GDP equals gdp_initial.</doc>
				<eqn>2015</eqn>
				<units>Year</units>
			</aux>
			<aux name="gdp initial" ai_state="C">
				<doc>GDP in the start year (2015).</doc>
				<eqn>293480</eqn>
				<units>Million_USD/Year</units>
			</aux>
			<aux name="baseline gdp growth rate" ai_state="C">
				<doc>Baseline GDP growth rate independent of innovation.</doc>
				<eqn>0.028</eqn>
				<units>1/Year</units>
			</aux>
			<aux name="innovation gdp elasticity" ai_state="C">
				<doc>Added GDP growth per unit of innovative firm share.</doc>
				<eqn>0.0207</eqn>
				<units>1/Year</units>
			</aux>
			<aux name="attractiveness floor" ai_state="C">
				<doc>Minimum attractiveness of the STI system.</doc>
				<eqn>0.5</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="attractiveness saturation weight" ai_state="C">
				<doc>Weight of saturating solutions effect on attractiveness.</doc>
				<eqn>0.5</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="attractiveness innovation weight" ai_state="C">
				<doc>Weight of innovative firm share on attractiveness.</doc>
				<eqn>1.0</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="ref rd gdp pct" ai_state="C">
				<doc>Calibration reference (R&amp;D % of GDP), Time 2005-2025. Placeholder zeros: replace with CSV data 03_calibracion_stella_horizontal_2026_conpes_ctei_colombia.csv.</doc>
				<eqn>TIME</eqn>
				<gf>
					<yscale min="0" max="0.004202"/>
					<xpts>2005,2006,2007,2008,2009,2010,2011,2012,2013,2014,2015,2016,2017,2018,2019,2020</xpts>
					<ypts>0.001656,0.001643,0.001831,0.001954,0.001935,0.001936,0.001984,0.002212,0.002576,0.003032,0.003654,0.002705,0.002611,0.003123,0.00322,0.002894</ypts>
				</gf>
				<units>dmnl</units>
			</aux>
			<aux name="ref researchers per million" ai_state="C">
				<doc>Calibration reference (researchers per million), 2005-2025. Placeholder zeros pending CSV import.</doc>
				<eqn>TIME</eqn>
				<gf>
					<yscale min="0" max="104.9"/>
					<xpts>2013,2014,2015,2016,2017</xpts>
					<ypts>58.0547,59.0548,70.6693,91.2603,90.2473</ypts>
				</gf>
				<units>People</units>
			</aux>
			<aux name="ref resident patents" ai_state="C">
				<doc>Calibration reference (resident patents), 2005-2025. Placeholder zeros pending CSV import.</doc>
				<eqn>TIME</eqn>
				<gf>
					<yscale min="0" max="1270"/>
					<xpts>2005,2006,2007,2008,2009,2010,2011,2012,2013,2014,2015,2016,2017,2018,2019,2020,2021,2022,2023,2024</xpts>
					<ypts>99,142,128,126,128,133,183,213,251,260,321,545,595,415,422,369,432,1104,266,270</ypts>
				</gf>
				<units>Projects</units>
			</aux>
			<aux name="ref hightech exports pct" ai_state="C">
				<doc>Calibration reference (high-tech exports %), 2005-2025. Placeholder zeros pending CSV import.</doc>
				<eqn>TIME</eqn>
				<gf>
					<yscale min="0" max="0.1171"/>
					<xpts>2007,2008,2009,2010,2011,2012,2013,2014,2015,2016,2017,2018,2019,2020,2021,2022,2023,2024</xpts>
					<ypts>0.030653,0.040154,0.055542,0.053625,0.046796,0.056774,0.077684,0.081198,0.098493,0.101858,0.089624,0.072214,0.090485,0.099136,0.082091,0.084018,0.085999,0.090284</ypts>
				</gf>
				<units>dmnl</units>
			</aux>
			<aux name="ref real gdp growth pct" ai_state="C">
				<doc>Calibration reference (real GDP growth %), 2005-2025. Placeholder zeros pending CSV import.</doc>
				<eqn>TIME</eqn>
				<gf>
					<yscale min="-0.07186" max="0.1242"/>
					<xpts>2005,2006,2007,2008,2009,2010,2011,2012,2013,2014,2015,2016,2017,2018,2019,2020,2021,2022,2023,2024,2025</xpts>
					<ypts>0.048288,0.067169,0.067382,0.032834,0.011396,0.044947,0.069479,0.039126,0.05134,0.04499,0.029559,0.020874,0.013594,0.025643,0.031869,-0.071859,0.108012,0.073283,0.008418,0.014933,0.02642</ypts>
				</gf>
				<units>1/Year</units>
			</aux>
			<aux name="ref tertiary enrollment pct" ai_state="C">
				<doc>Calibration reference (tertiary enrollment %), 2005-2025. Placeholder zeros pending CSV import.</doc>
				<eqn>TIME</eqn>
				<gf>
					<yscale min="0" max="0.6818"/>
					<xpts>2005,2006,2007,2008,2009,2010,2011,2012,2013,2014,2015,2016,2017,2018,2019,2020,2021,2022</xpts>
					<ypts>0.32254,0.343662,0.354785,0.379448,0.395088,0.415297,0.452873,0.47467,0.507475,0.531794,0.547961,0.571437,0.58396,0.573205,0.566663,0.557331,0.583159,0.592901</ypts>
				</gf>
				<units>dmnl</units>
			</aux>
			<aux name="incose rigor index" ai_state="C" access="output" isee:autocreated="true">
				<doc>Systems engineering rigor policy lever (0-1).</doc>
				<eqn>0.6</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="gov uni ind linkage" ai_state="C" access="output" isee:autocreated="true">
				<doc>Government-university-industry linkage policy lever (0-1).</doc>
				<eqn>0.5</eqn>
				<units>dmnl</units>
			</aux>
			<stock name="innovative firms" ai_state="C" access="input">
				<doc>Innovative firms.</doc>
				<eqn>8000</eqn>
				<units>Firms</units>
			</stock>
			<aux name="total firms" ai_state="C" access="input">
				<doc>Total firms; changes only via creation and exit.</doc>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>Firms</units>
			</aux>
			<stock name="active industrial solutions" ai_state="C" access="input">
				<doc>Solutions in industrial use.</doc>
				<eqn>600</eqn>
				<units>Projects</units>
			</stock>
			<aux name="ref solutions half sat" ai_state="C" access="input">
				<doc>Half-saturation level of active solutions.</doc>
				<eqn>600.0</eqn>
				<units>Projects</units>
			</aux>
		</variables>
