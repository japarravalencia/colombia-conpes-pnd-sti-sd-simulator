	<model name="Sector_3_RD_Projects_and_Solutions">
		<variables>
			<aux name="total projects" ai_state="C">
				<doc>Conservation total of the project chain (changes only via initiation, stagnation, obsolescence).</doc>
				<eqn>rd_projects_pipeline + transferred_solutions + active_industrial_solutions</eqn>
				<units>Projects</units>
			</aux>
			<aux name="transfer efficacy" ai_state="C">
				<doc>Effective technology transfer multiplier combining systems engineering discipline with university-industry linkages.</doc>
				<eqn>incose_weight*incose_rigor_index+linkage_weight*gov_uni_ind_linkage</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="desired project starts" ai_state="C" access="output" isee:autocreated="true">
				<doc>Volume of new project proposals formulated by the domestic researcher workforce.</doc>
				<eqn>active_sti_talent*project_proposal_propensity</eqn>
				<units>Projects/Year</units>
			</aux>
			<aux name="avg project duration" ai_state="C">
				<doc>Mean project duration.</doc>
				<eqn>3</eqn>
				<units>Year</units>
			</aux>
			<aux name="incose weight" ai_state="C">
				<doc>Weight of rigor in transfer efficacy.</doc>
				<eqn>0.7</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="linkage weight" ai_state="C">
				<doc>Weight of linkage in transfer efficacy.</doc>
				<eqn>0.3</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="delay time rd transfer" ai_state="C">
				<doc>Transfer delay.</doc>
				<eqn>4</eqn>
				<units>Year</units>
			</aux>
			<aux name="stagnation rate base" ai_state="C">
				<doc>Fractional stagnation rate of transferred solutions.</doc>
				<eqn>0.1588</eqn>
				<units>1/Year</units>
			</aux>
			<aux name="solution lifetime" ai_state="C">
				<doc>Mean solution lifetime.</doc>
				<eqn>8</eqn>
				<units>Year</units>
			</aux>
			<aux name="project proposal propensity" ai_state="C">
				<doc>Proposal submission productivity per active domestic researcher.</doc>
				<eqn>0.1075</eqn>
				<units>Projects/(People*Year)</units>
			</aux>
			<flow name="new rd project initiation" ai_state="C">
				<doc>Rate of initiating new research endeavors supported by allocated funding.</doc>
				<eqn>rd_project_funding_rate/avg_cost_per_project</eqn>
				<non_negative/>
				<units>Projects/Year</units>
			</flow>
			<flow name="project completion rate" ai_state="C">
				<doc>Annual volume of research projects successfully completing the developmental stage.</doc>
				<eqn>rd_projects_pipeline/avg_project_duration</eqn>
				<non_negative/>
				<units>Projects/Year</units>
			</flow>
			<flow name="solution transfer rate" ai_state="C">
				<doc>Successful deployment of intellectual property into productive industrial application.</doc>
				<eqn>transferred_solutions*transfer_efficacy/delay_time_rd_transfer</eqn>
				<non_negative/>
				<units>Projects/Year</units>
			</flow>
			<flow name="transfer stagnation rate" ai_state="C">
				<doc>Valley of death attrition where prototypes fail commercial transfer due to institutional friction.</doc>
				<eqn>transferred_solutions*stagnation_rate_base</eqn>
				<non_negative/>
				<units>Projects/Year</units>
			</flow>
			<flow name="solution obsolescence rate" ai_state="C">
				<doc>Technological depreciation and phase-out of industrial solutions over time.</doc>
				<eqn>active_industrial_solutions/solution_lifetime</eqn>
				<non_negative/>
				<units>Projects/Year</units>
			</flow>
			<aux name="rd project funding rate" ai_state="C" access="input">
				<doc>Actual fiscal capital disbursed to execute approved research projects.</doc>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>Million_USD/Year</units>
			</aux>
			<aux name="avg cost per project" ai_state="C" access="output" isee:autocreated="true">
				<doc>Average cost per R&amp;D project.</doc>
				<eqn>2.1187</eqn>
				<units>Million_USD/Projects</units>
			</aux>
			<aux name="ref solutions half sat" ai_state="C" access="output" isee:autocreated="true">
				<doc>Half-saturation level of active solutions.</doc>
				<eqn>600.0</eqn>
				<units>Projects</units>
			</aux>
			<stock name="rd projects pipeline" ai_state="C">
				<doc>R&amp;D projects under execution.</doc>
				<eqn>950</eqn>
				<inflow>new_rd_project_initiation</inflow>
				<outflow>project_completion_rate</outflow>
				<units>Projects</units>
			</stock>
			<stock name="transferred solutions" ai_state="C">
				<doc>Completed projects awaiting industrial transfer.</doc>
				<eqn>350</eqn>
				<inflow>project_completion_rate</inflow>
				<outflow>solution_transfer_rate</outflow>
				<outflow>transfer_stagnation_rate</outflow>
				<units>Projects</units>
			</stock>
			<stock name="active industrial solutions" ai_state="C" access="output" isee:autocreated="true">
				<doc>Solutions in industrial use.</doc>
				<eqn>600</eqn>
				<inflow>solution_transfer_rate</inflow>
				<outflow>solution_obsolescence_rate</outflow>
				<units>Projects</units>
			</stock>
			<aux name="incose rigor index" ai_state="C" access="input">
				<doc>Systems engineering rigor policy lever (0-1).</doc>
				<eqn>0.6</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="gov uni ind linkage" ai_state="C" access="input">
				<doc>Government-university-industry linkage policy lever (0-1).</doc>
				<eqn>0.5</eqn>
				<units>dmnl</units>
			</aux>
			<stock name="active sti talent" ai_state="C" access="input">
				<doc>STI talent active domestically.</doc>
				<eqn>3550</eqn>
				<units>People</units>
			</stock>
		</variables>
		<views>
			<style color="black" background="white" font_style="normal" font_weight="normal" text_decoration="none" text_align="center" vertical_text_align="center" font_color="black" font_family="Arial" font_size="10pt" padding="2" border_color="black" border_width="thin" border_style="none">
				<text_box color="black" background="white" text_align="left" vertical_text_align="top" font_size="12pt"/>
				<isee:loop_indicator color="black" background="white" vertical_text_align="top" font_size="12pt"/>
				<numeric_display color="white" background="white" font_size="12pt" border_width="thin" border_style="solid" isee:transparent="false" isee:show_divider="true" isee:show_bounding_box="true" label_side="left"/>
				<graph color="black" background="white" font_size="12pt" axis_color="#666666" grid_color="#C8C8C8" isee:graph_area_color="white" legend_position="bottom" isee:transparent="false" isee:hide_border="false" axis_title_font_style="normal" axis_title_font_weight="normal" axis_title_text_decoration="none" axis_title_text_align="center" axis_title_vertical_text_align="center" axis_title_font_color="black" axis_title_font_family="Arial" axis_title_font_size="12pt" axis_title_text_padding="2" axis_title_text_border_color="black" axis_title_text_border_width="thin" axis_title_text_border_style="none" axis_label_font_style="normal" axis_label_font_weight="normal" axis_label_text_decoration="none" axis_label_text_align="center" axis_label_vertical_text_align="center" axis_label_font_color="black" axis_label_font_family="Arial" axis_label_font_size="9pt" axis_label_text_padding="2" axis_label_text_border_color="black" axis_label_text_border_width="thin" axis_label_text_border_style="none">
					<isee:series_styles>
						<isee:series_style color="blue" thickness="1"/>
						<isee:series_style color="red" thickness="1" pen_style="dot_dashed"/>
						<isee:series_style color="fuchsia" thickness="1" pen_style="dotted"/>
						<isee:series_style color="#008F44" thickness="1" pen_style="dashed"/>
						<isee:series_style color="#FF7F00" thickness="1"/>
