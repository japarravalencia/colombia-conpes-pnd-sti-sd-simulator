				</connector>
				<connector uid="4" polarity="-" isee:polarity_placement="outside" angle="349.696">
					<isee:documentation>Reasoning:
Longer project execution slows completion velocity.

Polarity Reasoning: 
Reduces completion rate.</isee:documentation>
					<isee:reasoning>Longer project execution slows completion velocity.</isee:reasoning>
					<isee:polarity_reasoning>Reduces completion rate.</isee:polarity_reasoning>
					<from>avg_project_duration</from>
