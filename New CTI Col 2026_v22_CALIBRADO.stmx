	</model>
	<model name="Sector_4_Fiscal_Liquidity_and_Rationing">
		<variables>
			<aux name="rd project funding demand" ai_state="C">
				<doc>Capital demanded to underwrite all proposed R&amp;D projects.</doc>
				<eqn>desired_project_starts*avg_cost_per_project</eqn>
				<units>Million_USD/Year</units>
			</aux>
			<aux name="talent program funding demand" ai_state="C">
				<doc>Fiscal resources required to enroll desired new talent cohorts.</doc>
				<eqn>desired_talent_intake*cost_per_talent_trained</eqn>
				<units>Million_USD/Year</units>
			</aux>
			<aux name="total funding demand" ai_state="C">
				<doc>Aggregate budgetary demands submitted to the national STI agency.</doc>
				<eqn>rd_project_funding_demand+talent_program_funding_demand</eqn>
				<units>Million_USD/Year</units>
			</aux>
			<aux name="max affordable spending" ai_state="C">
				<doc>Ceiling on sustainable annual disbursements to prevent liquidity exhaustion.</doc>
				<eqn>rd_budget_stock/budget_min_liquidity_time</eqn>
				<units>Million_USD/Year</units>
			</aux>
			<aux name="budget execution ratio" ai_state="C">
				<doc>Rationing fraction representing the proportion of submitted STI requests that can be disbursed.</doc>
				<eqn>MIN(1,(max_affordable_spending*budget_execution_efficiency)/MAX(min_demand_floor,total_funding_demand))</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="gdp rd allocation target" ai_state="C">
				<doc>Share of GDP allocated to R&amp;D.</doc>
				<eqn>0.0029</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="external rd funding base" ai_state="C">
				<doc>External R&amp;D funding.</doc>
				<eqn>80</eqn>
				<units>Million_USD/Year</units>
			</aux>
			<aux name="budget min liquidity time" ai_state="C">
				<doc>Minimum liquidity horizon.</doc>
				<eqn>0.5</eqn>
				<units>Year</units>
			</aux>
			<aux name="budget execution efficiency" ai_state="C">
				<doc>Fraction of affordable spending executable.</doc>
				<eqn>0.75</eqn>
				<units>dmnl</units>
			</aux>
			<aux name="min demand floor" ai_state="C">
				<doc>Floor on funding demand to avoid division by zero.</doc>
				<eqn>0.001</eqn>
				<units>Million_USD/Year</units>
			</aux>
			<flow name="gdp contribution to rd" ai_state="C">
				<doc>National budgetary allocations dedicated to research and development tied to GDP scale.</doc>
				<eqn>gdp*gdp_rd_allocation_target</eqn>
				<non_negative/>
				<units>Million_USD/Year</units>
			</flow>
			<flow name="external rd funding" ai_state="C">
				<doc>Inflows from international cooperation, royalities, and multilateral development funds.</doc>
				<eqn>external_rd_funding_base</eqn>
				<non_negative/>
				<units>Million_USD/Year</units>
			</flow>
			<flow name="rd project funding rate" ai_state="C" access="output" isee:autocreated="true">
				<doc>Actual fiscal capital disbursed to execute approved research projects.</doc>
				<eqn>rd_project_funding_demand*budget_execution_ratio</eqn>
				<non_negative/>
				<units>Million_USD/Year</units>
			</flow>
			<flow name="talent program funding rate" ai_state="C" access="output" isee:autocreated="true">
				<doc>Actual fiscal capital disbursed to fund postgraduate trainees and doctoral grants.</doc>
				<eqn>talent_program_funding_demand*budget_execution_ratio</eqn>
				<non_negative/>
				<units>Million_USD/Year</units>
			</flow>
			<stock name="rd budget stock" ai_state="C">
				<doc>R&amp;D budget liquidity.</doc>
				<eqn>450</eqn>
				<inflow>gdp_contribution_to_rd</inflow>
				<inflow>external_rd_funding</inflow>
				<outflow>rd_project_funding_rate</outflow>
				<outflow>talent_program_funding_rate</outflow>
				<units>Million_USD</units>
			</stock>
			<stock name="gdp" ai_state="C" access="input">
				<doc>National gross domestic product evolving as a continuous stock.</doc>
				<eqn>293480</eqn>
				<units>Million_USD/Year</units>
			</stock>
			<aux name="desired project starts" ai_state="C" access="input">
				<doc>Volume of new project proposals formulated by the domestic researcher workforce.</doc>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>Projects/Year</units>
			</aux>
			<aux name="desired talent intake" ai_state="C" access="input">
				<doc>Target annual recruitment of advanced students scaled by ecosystem prestige and attractiveness.</doc>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>People/Year</units>
			</aux>
			<aux name="cost per talent trained" ai_state="C" access="output" isee:autocreated="true">
				<doc>Cost per trained person.</doc>
				<eqn>0.205</eqn>
				<units>Million_USD/People</units>
			</aux>
			<stock name="active sti talent" ai_state="C" access="input">
				<doc>STI talent active domestically.</doc>
				<eqn>3550</eqn>
				<units>People</units>
			</stock>
			<aux name="avg cost per project" ai_state="C" access="input">
				<doc>Average cost per R&amp;D project.</doc>
				<eqn>2.1187</eqn>
				<units>Million_USD/Projects</units>
			</aux>
		</variables>
		<views>
			<style color="black" background="white" font_style="normal" font_weight="normal" text_decoration="none" text_align="center" vertical_text_align="center" font_color="black" font_family="Arial" font_size="10pt" padding="2" border_color="black" border_width="thin" border_style="none">
				<text_box color="black" background="white" text_align="left" vertical_text_align="top" font_size="12pt"/>
				<isee:loop_indicator color="black" background="white" vertical_text_align="top" font_size="12pt"/>
				<numeric_display color="white" background="white" font_size="12pt" border_width="thin" border_style="solid" isee:transparent="false" isee:show_divider="true" isee:show_bounding_box="true" label_side="left"/>
